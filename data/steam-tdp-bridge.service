[Unit]
Description=Steam TDP Bridge (MSI Claw A8)
# Started independently of the session. It never gates graphical-session.target
# and does not touch the platform profile until Steam is up.
After=local-fs.target

[Service]
Type=dbus
BusName=com.steampowered.TdpBridge
ExecStart=/usr/bin/steam-tdp-bridge
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
